# Backend
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ANTHROPIC_API_KEY=your-key-here  # Step 2 で使用

# フロントエンド(Next.jsサーバー側)とバックエンド間で共有するAPIキー
# 生成例: openssl rand -hex 32
X_API_KEY=

# レート制限（session_id単位）
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_SESSION_MAX=30

# Vercel Redis (Redis Cloud) — 会話履歴・レート制限カウンタの保存先
# 例: redis://default:PASSWORD@HOST:PORT
REDIS_URL=

# Frontend
# ブラウザから叩くURL
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.jsサーバー側(Route Handler)からbackendへ中継する際の接続先
# docker-compose利用時は http://backend:8000
API_URL=http://localhost:8000
