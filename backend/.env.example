DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
# ANTHROPIC_API_KEY=your-key-here  # Step 2 で使用

# セッションの有効期限（分単位）
SESSION_TTL_MINUTES=
# セッションの掃除間隔（秒単位）
SESSION_SWEEP_INTERVAL_SECONDS=

# フロントエンド(Next.jsサーバー側)とバックエンド間で共有するAPIキー
# 生成例: openssl rand -hex 32
X_API_KEY=

# レート制限（session_id単位）
# 1分あたりの最大リクエスト数
RATE_LIMIT_PER_MINUTE=10
# セッション生存期間中の累計最大リクエスト数
RATE_LIMIT_SESSION_MAX=30